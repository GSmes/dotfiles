[alias]
  ci = commit
  co = checkout
  f = fetch
  s = status
  b = branch
  d = diff
  a = add
  l = log
  ctags = !.git/hooks/ctags
[core]
  excludesfile = ~/.gitignore
[color]
  ui = auto
[merge]
  # Show merge statistics after merge.
  stat = true
  ff = only
[include]
  path = .gitconfig.local
[commit]
  template = ~/.gitmessage
[push]
  default = simple
[pull]
  ff = only
[user]
	name = GSmes
	email = garrett.smestad@gmail.com
[credential]
	helper = osxkeychain
[init]
  templatedir = ~/.git_template
	defaultBranch = main
[branch]
  autosetupmerge = always
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
